# Copy to server/.env and restart the API (npm run dev). Real environment variables override this file.
# Never commit server/.env - it holds secrets.

# --- Database / data locations (optional) ---
# CAMPAIGNIQ_DB=server/data/campaigniq-python.db
# CAMPAIGNIQ_REFERENCE_DIR=server/data/reference
# CAMPAIGNIQ_DATASET_CATALOG=server/data/datasets/catalog.json

# --- Hosting ---
# Websites allowed to call the API from a browser (comma-separated, scheme + host only).
# For GitHub Pages: https://<your-username>.github.io   (localhost:5173 is always allowed)
# CAMPAIGNIQ_CORS_ORIGINS=

# --- AI Co-pilot ---
# demo (no LLM, built-in illustrative answers) | openai (OpenAI or any OpenAI-compatible server) | azure_openai
COPILOT_PROVIDER=demo
COPILOT_MODEL=
COPILOT_API_KEY=
COPILOT_TIMEOUT_SECONDS=60

# openai / OpenAI-compatible (vLLM, Ollama http://localhost:11434/v1, LM Studio, corporate gateway)
COPILOT_BASE_URL=https://api.openai.com/v1

# azure_openai
COPILOT_AZURE_ENDPOINT=
COPILOT_AZURE_DEPLOYMENT=
COPILOT_AZURE_API_VERSION=2024-06-01

# Optional: custom system prompt file
# COPILOT_SYSTEM_PROMPT=server/data/prompts/copilot_system.md

# --- Web app (put in web/.env) ---
# VITE_API_URL=http://localhost:8000/api
# On GitHub Pages this comes from the repository variable VITE_API_URL (see DEPLOYMENT.md).
